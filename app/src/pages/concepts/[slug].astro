---
import { concepts } from '../../data/concepts';
export function getStaticPaths() {
  return concepts.map(concept => ({ params: { slug: concept.slug }, props: { concept } }));
}
const { concept } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{concept.title} — Anonymized project screen | Kurt Gavin</title>
    <meta name="description" content={`${concept.title}: recreated from project references with branding, data and visual design anonymized.`} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <header>
        <a class="back-link" href={`/work/#${concept.slug}`}>&larr; Back to work</a>
        <p class="eyebrow">Confidential project / NDA</p>
        <h1>{concept.title}</h1>
        <p class="summary">{concept.description}</p>
        <p class="notice">Recreated from project references. Branding, data and visual design anonymized.</p>
      </header>
      <figure>
        <a href={concept.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${concept.title} recreation in a new tab`}>
          <img src={concept.image} alt={`${concept.title} interface recreated from project references, with anonymized branding, data and visual design.`} loading="eager" decoding="async" />
        </a>
        <figcaption>View the complete screen above, or <a href={concept.image} target="_blank" rel="noopener noreferrer">open full-size image <span aria-hidden="true">↗</span></a>.</figcaption>
      </figure>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #e9eaeb; color: #1c1d20; font-family: Inter, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  main { max-width: 1800px; margin: 0 auto; padding: clamp(20px, 4vw, 64px); }
  header { max-width: 980px; margin-bottom: 32px; }
  a { color: inherit; text-underline-offset: 4px; }
  a:focus-visible { outline: 3px solid #455ce9; outline-offset: 6px; }
  .back-link { display: inline-block; margin-bottom: 48px; font-size: 14px; }
  .eyebrow { margin: 0 0 16px; font-size: 11px; text-transform: uppercase; letter-spacing: .16em; color: #55585e; }
  h1 { margin: 0 0 20px; font-size: clamp(30px, 5vw, 64px); font-weight: 450; line-height: 1.06; letter-spacing: -.035em; }
  .summary { max-width: 850px; font-size: clamp(15px, 1.5vw, 18px); line-height: 1.65; }
  .notice { margin-top: 24px; font-size: 13px; line-height: 1.6; color: #55585e; }
  figure { margin: 0; }
  figure > a { display: block; line-height: 0; }
  img { display: block; width: 100%; height: auto; border: 1px solid #d2d4d8; border-radius: 4px; }
  figcaption { margin-top: 16px; font-size: 13px; line-height: 1.6; color: #55585e; }
  @media (max-width: 600px) { .back-link { margin-bottom: 32px; } header { margin-bottom: 24px; } }
</style>
